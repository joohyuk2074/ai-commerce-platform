{
  "index_patterns": ["event-order-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s",
      "index": {
        "max_result_window": 10000
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "eventType": {
          "type": "keyword"
        },
        "orderId": {
          "type": "keyword"
        },
        "userId": {
          "type": "keyword"
        },
        "orderStatus": {
          "type": "keyword"
        },
        "totalAmount": {
          "type": "scaled_float",
          "scaling_factor": 100
        },
        "currency": {
          "type": "keyword"
        },
        "paymentMethod": {
          "type": "keyword"
        },
        "items": {
          "type": "nested",
          "properties": {
            "productId": {
              "type": "keyword"
            },
            "productName": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "categoryId": {
              "type": "keyword"
            },
            "categoryName": {
              "type": "keyword"
            },
            "quantity": {
              "type": "integer"
            },
            "price": {
              "type": "scaled_float",
              "scaling_factor": 100
            },
            "subtotal": {
              "type": "scaled_float",
              "scaling_factor": 100
            }
          }
        },
        "pointsUsed": {
          "type": "integer"
        },
        "pointsEarned": {
          "type": "integer"
        },
        "shippingAddress": {
          "properties": {
            "country": {
              "type": "keyword"
            },
            "city": {
              "type": "keyword"
            },
            "zipCode": {
              "type": "keyword"
            }
          }
        },
        "environment": {
          "type": "keyword"
        },
        "platform": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "@metadata": {
          "type": "object",
          "enabled": false
        }
      }
    }
  },
  "priority": 100,
  "_meta": {
    "description": "Template for order event data",
    "version": 1
  }
}
