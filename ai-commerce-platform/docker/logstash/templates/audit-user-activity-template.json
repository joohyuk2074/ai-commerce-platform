{
  "index_patterns": ["audit-user-activity-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s",
      "index": {
        "max_result_window": 10000
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "userId": {
          "type": "keyword"
        },
        "action": {
          "type": "keyword"
        },
        "service": {
          "type": "keyword"
        },
        "resource": {
          "type": "keyword"
        },
        "method": {
          "type": "keyword"
        },
        "path": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "query": {
          "type": "text",
          "index": false
        },
        "statusCode": {
          "type": "short"
        },
        "status_category": {
          "type": "keyword"
        },
        "responseTime": {
          "type": "integer"
        },
        "performance": {
          "type": "keyword"
        },
        "clientIp": {
          "type": "ip"
        },
        "userAgent": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        "ua": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "os": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "full": {
                  "type": "keyword"
                },
                "version": {
                  "type": "keyword"
                }
              }
            },
            "os_name": {
              "type": "keyword"
            },
            "device": {
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            },
            "major": {
              "type": "keyword"
            },
            "minor": {
              "type": "keyword"
            },
            "patch": {
              "type": "keyword"
            }
          }
        },
        "environment": {
          "type": "keyword"
        },
        "platform": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "@metadata": {
          "type": "object",
          "enabled": false
        }
      }
    }
  },
  "priority": 100,
  "_meta": {
    "description": "Template for user activity audit logs",
    "version": 1
  }
}
